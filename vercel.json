{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": ".",
  "routes": [
    {
      "src": "/api/sendResults",
      "dest": "/api/sendResults.js"
    },
    {
      "src": "/api/getReview",
      "dest": "/api/getReview.js"
    },
    {
      "src": "/review/(.*)",
      "dest": "/review/index.html"
    }
  ]
}